{{<local_mxaimanager/reusable/manage_page}}
    {{$content}}
        <div class="modal show position-relative" id="myModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5>{{#str}}manage_providers:delete_provider, local_mxaimanager, {{name}}{{/str}}</h5>
                    </div>
                    <div class="modal-body">
                        {{#str}}manage_providers:delete_confirm, local_mxaimanager{{/str}}
                    </div>
                    <div class="modal-footer">
                        <form method="post" action="{{delete_url}}">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="confirmed" value="1">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <button type="submit" class="btn btn-danger">
                                {{#str}}confirm, core{{/str}}
                            </button>
                        </form>
                        <a href="{{cancel_url}}"
                           class="btn btn-secondary">
                            {{#str}}cancel, core{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {{/content}}
{{/local_mxaimanager/reusable/manage_page}}
